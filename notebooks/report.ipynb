    "import matplotlib.pyplot as plt\n",
    "from src import viz as v\n",
    "from src import metrics as M\n",
    "\n",
    "# Ändrar på formatet på kolumnen \"date\" i dataframen. Frå sträng till datumsformat.\n",
    "df[\"date\"] = pd.to_datetime(df[\"date\"])\n",
    "# Grupperar datan i kolumnen \"revenue\" per månad och räknar ut medel (AOV) och median för varje månad.\n",
    "monthly_stats = df.groupby(df[\"date\"].dt.to_period(\"M\"))[\"revenue\"].agg(\n",
    "    [\"mean\", \n",
    "     \"median\"])\n",
    "\n",
    "# Formen för diagrammet initieras\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "# Skickar datan till funktionen som ska rita diagrammen\n",
    "v.plot_monthly_data(ax, monthly_stats)\n",
    "\n",
    "plt.show()\n",
    "\n",
    "# Här presenteras resultatet för aov och median för hela datamängden.\n",
    "print(f\"AOV för de första sex månaderna 2024 är: {M.average_order_value(sales_list):.0f} kr.\")\n",
    "print(f\"Medianen för de första sex månaderna 2024 är: {M.calc_median(sales_list):.0f} kr.\")\n"
   ]
    "\n",
    "sys.path.append(os.path.abspath(\"..\"))\n",
    "from src import load_data, EcommerceAnalyzer\n",
    "from src.viz import (\n",
    "    plot_category_analysis,\n",
    "    plot_revenue_by_category\n",
    "    )\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "# Hämtar in data med load_data\n",
    "data = load_data(\"../Data/ecommerce_sales.csv\")\n",
    "\n",
    "# Omvandlar data till en dataframe\n",
    "df = pd.DataFrame(data)\n",
    "\n",
    "# Hämtar in analyserna från EcommerceAnalyser\n",
    "analysis = EcommerceAnalyzer(data)\n",
    "\n",
    "# Category analysis\n",
    "category_counts, revenue_per_category = analysis.category_analysis()\n",
    "plot_category_analysis(category_counts, revenue_per_category)"
   ]
  }
